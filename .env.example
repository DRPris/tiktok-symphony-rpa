# ============================================
# RPA 系统环境变量配置示例
# 复制此文件为 .env 后再填入真实值，.env 不会提交到 git
# ============================================

# ── 通义千问 (Qwen) DashScope OpenAI 兼容 API ──
# 获取地址: https://dashscope.console.aliyun.com/apiKey
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 可选：qwen-turbo（快但弱） / qwen-plus（推荐） / qwen-max（强但慢贱）

# 视觉模型（用于产品图质量打分：分辨率/主体突出/背景是否简洁）
LLM_VISION_MODEL=qwen-vl-plus
# 可选：qwen-vl-plus（推荐、便宜） / qwen-vl-max（更准但贵）

# 单次 LLM 请求超时 (ms)
LLM_TIMEOUT=60000
